# ===== ILias AEGIS v2 회사 서버판(도커) 설정 =====  이 파일을 .env 로 복사해 고칩니다: cp env.example .env
# 비밀값은 넣지 않습니다. 암호 키는 첫 시작 때 ./keys 에 자동 생성됩니다(이 폴더는 자료 백업과 따로 보관).
AEGIS_SERVER_NAMES=aegis.example.local,192.168.0.10
AEGIS_TLS_MODE=internal
AEGIS_HTTPS_FIELD_PORT=443
AEGIS_HTTPS_ADMIN_PORT=8443
AEGIS_HTTPS_BOARD_PORT=8444
AEGIS_HTTPS_VAULT_PORT=9444
# ★ 관리 앱 허용 대역(자리표시 — 회사 대역으로 반드시 확인·수정)
AEGIS_ADMIN_ALLOW_CIDRS=192.168.0.0/24
AEGIS_BOARD_ALLOW_CIDRS=*
AEGIS_VAULT_ALLOW_CIDRS=
AEGIS_BACKUP_TIME=02:30
AEGIS_BACKUP_KEEP=30
TZ=Asia/Seoul
